{
	"name": "multi-line-tower",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "bun test",
		"changelog": "bun scripts/changelog.ts",
		"reset": "bun server/resetLocalDatabase.ts",
		"dev": "bun run --watch --parallel client server",
		"client": "bunx vite --host 0.0.0.0",
		"server": "bun --watch server/server.ts",
		"start": "bun server/server.ts",
		"build": "bunx tsc --noEmit && bunx vite build",
		"prod": "bun run --parallel build start",
		"preview": "bunx vite preview --host 0.0.0.0"
	},
	"dependencies": {
		"@types/three": "^0.185.1",
		"@vitejs/plugin-basic-ssl": "^2.1.0",
		"three": "^0.185.1",
		"typescript": "^5.8.0",
		"vite": "^7.0.0",
		"ws": "^8.18.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^24.0.0",
		"@types/ws": "^8.5.13",
		"bun-types": "^1.3.0"
	}
}
