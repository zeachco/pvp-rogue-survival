{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"files": {
		"includes": ["**", "!dist"]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"rules": {
			"a11y": {
				"noLabelWithoutControl": "off",
				"useAriaPropsSupportedByRole": "off",
				"useHeadingContent": "off"
			},
			"correctness": {
				"noVoidTypeReturn": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.tsx"],
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			},
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
